# Copy to .env and fill in. Never commit the .env file!

# --- Mode: the ib-gateway container (default) or a TWS / IB Gateway running on the docker host.
# Uncomment to use the host TWS by default (TWS_USERID / TWS_PASSWORD are then unused, any placeholder will do):
#COMPOSE_FILE=docker-compose.yml:docker-compose.host-tws.yml:docker-compose.expose.yml
# Host TWS API port: 7497 paper TWS, 7496 live TWS, 4002 / 4001 IB Gateway
#HOST_TWS_PORT=7497
# Fixed address of the facade on the host-tws network, add it to the TWS Trusted IPs
#HOST_TWS_CLIENT_IP=172.31.250.10
#HOST_TWS_SUBNET=172.31.250.0/24
# The facade reaches the host through this address (gateway of the subnet above)
#HOST_TWS_GATEWAY=172.31.250.1

# --- IB Gateway (gnzsnz/ib-gateway): credentials of the PAPER trading user
TWS_USERID=
TWS_PASSWORD=
# paper or live. The facade refuses to place orders on a live account unless IBKR_ALLOW_LIVE=true
TRADING_MODE=paper
# Daily restart of IB Gateway without a new login (IBC), format: hh:mm AM/PM
AUTO_RESTART_TIME=11:45 PM
TIME_ZONE=Europe/Budapest
# Optional: VNC access to the gateway GUI (only reachable inside the docker network unless you publish 5900)
VNC_SERVER_PASSWORD=

# --- Redis 8 (with RedisTimeSeries)
REDIS_PASSWORD=change-me-to-a-long-random-string

# --- ibkrfacade
# IB Gateway paper API port inside the docker network (socat: 4004 -> 4002), live: 4003
IBKR_TWS_PORT=4004
IBKR_TWS_CLIENT_ID=1
# Orders on a live account are rejected unless this is true
IBKR_ALLOW_LIVE=false
# 1 = live market data, 3 = delayed (if the paper account has no market data subscription)
IBKR_MARKET_DATA_TYPE=1

# API token authentication (Authorization: Bearer <token>), tokens of at least 16 characters, eg.: openssl rand -hex 32
IBKR_SECURITY_ENABLED=true
IBKR_SECURITY_READ_TOKEN=
IBKR_SECURITY_WRITE_TOKEN=

# Host port of the REST API, used only with the docker-compose.expose.yml override (bound to 127.0.0.1)
IBKRFACADE_HOST_PORT=8082
